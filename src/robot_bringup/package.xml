<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_bringup</name>
  <version>0.1.0</version>
  <description>Master package: launches the whole delivery robot system (model/TF, vision, follower, optional navigation and Gazebo simulation) and loads parameters. No algorithms.</description>
  <maintainer email="developer@todo.todo">developer</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <!-- motion_chain_monitor (관찰 전용 진단 노드) -->
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <!-- stations (지점 저장/이동 도구) -->
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <!-- Packages launched by robot.launch.py -->
  <exec_depend>robot_vision</exec_depend>
  <exec_depend>robot_follower</exec_depend>
  <exec_depend>robot_navigation</exec_depend>   <!-- included when nav_mode != none -->
  <exec_depend>robot_safety</exec_depend>       <!-- present in the workspace, launched by hand for now -->
  <exec_depend>robot_description</exec_depend>  <!-- URDF / TF, always -->
  <exec_depend>robot_sim</exec_depend>          <!-- included when sim:=true -->
  <exec_depend>robot_base</exec_depend>         <!-- steer_sim_node when sim:=true (real robot: base.launch.py) -->
  <exec_depend>delivery_robot_bridge</exec_depend>  <!-- delivery_demo.launch.py esp32_port:=... (ESP32 bridge) -->

  <!-- TODO Future packages
  <exec_depend>robot_safety</exec_depend>
  <exec_depend>robot_control</exec_depend>
  <exec_depend>robot_bridge</exec_depend>
  <exec_depend>robot_ui</exec_depend>
  <exec_depend>robot_led</exec_depend>
  <exec_depend>robot_manager</exec_depend>
  <exec_depend>robot_interfaces</exec_depend>
  -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>xacro</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
