<?xml version="1.0"?>
<!--
  robot.urdf.xacro

  실제 모델의 루트는 base_link이다.
  base_link는 바퀴 축 높이의 기준 프레임이며 관성을 직접 갖지 않는다.

  base_link의 고정 자식:
    body_link: 차체 형상, 충돌 형상, 차체 관성
    base_footprint: 평면 주행 시 바닥 기준 프레임
    laser_link, imu_link, camera_link

  camera_link의 고정 자식:
    camera_optical_frame

  바퀴 4개는 base_link에 continuous joint로 연결된다.

  차체 관성을 고정 자식 body_link로 분리하여
  KDL의 루트 링크 관성 제한에 대응한다.
  치수는 robot_params.xacro(2026-10-27 CompleteDesign CAD 바운딩박스, 실측 아님)를 따른다:
  적재함이 로봇 전체를 덮고, 측면 디스플레이, 리프트 다리 4개, 전방 끝 아치 위 LiDAR,
  전면 하단 범퍼 중앙의 카메라 1대(camera_link).

  map / odom은 navigation이 담당한다.
  이 모델을 사용할 때 별도의 중복 센서 TF를 발행하지 않는다.

  카메라: Raspberry Pi Camera Module 3, 전방 중앙 1대만 활성(camera_link -> camera_optical_frame).
  2대(전방 좌우 '눈') 구성은 아래 '(비활성) 2번 카메라' 주석 블록과
  robot_params.xacro 의 전환 절차를 따를 때만 만든다. 기본 모델에는 camera_2_* 가 없다.

  sim:=false: 모델/TF용 URDF.
  sim:=true: gazebo.xacro의 센서와 구동 플러그인 포함.
-->
<robot name="delivery_robot"
       xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="sim" default="false"/>

  <xacro:include
    filename="$(find robot_description)/urdf/robot_params.xacro"/>

  <xacro:include
    filename="$(find robot_description)/urdf/macros.xacro"/>

  <!-- 바닥 기준 높이를 base_link 기준 상대 높이로 변환 -->
  <xacro:property name="base_z" value="${wheel_radius}"/>

  <material name="body_white">
    <color rgba="0.92 0.92 0.92 1.0"/>
  </material>

  <material name="frame_grey">
    <color rgba="0.45 0.45 0.45 1.0"/>
  </material>

  <material name="sensor_dark">
    <color rgba="0.20 0.20 0.22 1.0"/>
  </material>

  <!-- ====================================================
       base_link: 바퀴 축 높이의 기준 프레임, 모델의 루트
       ==================================================== -->
  <link name="${base_frame}"/>

  <!-- ====================================================
       base_footprint: 바닥 높이의 고정 프레임
       평면 주행을 가정한다.
       ==================================================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="${base_frame}"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 ${-base_z}" rpy="0 0 0"/>
  </joint>

  <!-- ====================================================
       body_link: 차체 형상, 충돌 형상, 차체 관성
       base_link와 같은 원점/방향에 고정한다.
       ==================================================== -->
  <link name="body_link">

    <!-- 하부 차체 -->
    <visual>
      <origin
        xyz="0 0 ${chassis_bottom_z + chassis_height/2 - base_z}"
        rpy="0 0 0"/>
      <geometry>
        <box
          size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="frame_grey"/>
    </visual>

    <collision>
      <origin
        xyz="0 0 ${chassis_bottom_z + chassis_height/2 - base_z}"
        rpy="0 0 0"/>
      <geometry>
        <box
          size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>

    <!-- 적재함 -->
    <visual>
      <origin
        xyz="${cargo_x_offset} 0 ${cargo_bottom_z + cargo_height/2 - base_z}"
        rpy="0 0 0"/>
      <geometry>
        <box size="${cargo_length} ${cargo_width} ${cargo_height}"/>
      </geometry>
      <material name="body_white"/>
    </visual>

    <!-- 충돌 형상은 측면 디스플레이까지 포함한 전체 폭(body_envelope_width)으로 둔다 -->
    <collision>
      <origin
        xyz="${cargo_x_offset} 0 ${cargo_bottom_z + cargo_height/2 - base_z}"
        rpy="0 0 0"/>
      <geometry>
        <box size="${cargo_length} ${body_envelope_width} ${cargo_height}"/>
      </geometry>
    </collision>

    <!-- 측면 디스플레이(베젤 포함) 좌/우: 시각화만 -->
    <xacro:macro name="display_visual" params="side">
      <visual>
        <origin
          xyz="${display_x} ${side * (body_envelope_width/2 - display_thickness/2)} ${display_z - base_z}"
          rpy="0 0 0"/>
        <geometry>
          <box
            size="${display_length} ${display_thickness} ${display_height}"/>
        </geometry>
        <material name="sensor_dark"/>
      </visual>
    </xacro:macro>

    <xacro:display_visual side="1"/>
    <xacro:display_visual side="-1"/>

    <!-- 리프트 다리 4개(적재함 아래): 시각화만, 충돌은 하부 섀시 상자가 담당 -->
    <xacro:macro name="lift_leg_visual" params="x y">
      <visual>
        <origin
          xyz="${x} ${y} ${lift_leg_center_z - base_z}"
          rpy="0 0 0"/>
        <geometry>
          <box
            size="${lift_leg_length} ${lift_leg_width} ${lift_leg_height}"/>
        </geometry>
        <material name="frame_grey"/>
      </visual>
    </xacro:macro>

    <xacro:lift_leg_visual x="${lift_leg_x}" y="${lift_leg_y}"/>
    <xacro:lift_leg_visual x="${lift_leg_x}" y="${-lift_leg_y}"/>
    <xacro:lift_leg_visual x="${-lift_leg_x}" y="${lift_leg_y}"/>
    <xacro:lift_leg_visual x="${-lift_leg_x}" y="${-lift_leg_y}"/>

    <!-- 손잡이 아치: 전방 끝(arch_x), 외함 위로 솟은 고리를 상자로 근사 -->
    <visual>
      <origin
        xyz="${arch_x} 0 ${arch_bar_z - base_z}"
        rpy="0 0 0"/>
      <geometry>
        <box
          size="${arch_bar_length} ${arch_bar_width} ${arch_bar_height}"/>
      </geometry>
      <material name="body_white"/>
    </visual>

    <collision>
      <origin
        xyz="${arch_x} 0 ${arch_bar_z - base_z}"
        rpy="0 0 0"/>
      <geometry>
        <box
          size="${arch_bar_length} ${arch_bar_width} ${arch_bar_height}"/>
      </geometry>
    </collision>

    <!-- LiDAR 마운트: 아치 위, LiDAR 외함 바닥까지 -->
    <visual>
      <origin
        xyz="${lidar_x} ${lidar_y} ${arch_bar_z + arch_bar_height/2 + lidar_mount_height/2 - base_z}"
        rpy="0 0 0"/>
      <geometry>
        <cylinder
          radius="${lidar_mount_radius}"
          length="${lidar_mount_height}"/>
      </geometry>
      <material name="frame_grey"/>
    </visual>

    <!-- 차체 관성: 기존 근사값을 이 링크에 배치 -->
    <xacro:box_inertial
      mass="${body_mass}"
      x="${body_inertia_length}"
      y="${body_inertia_width}"
      z="${body_inertia_height}">
      <origin
        xyz="0 0 ${body_com_z - base_z}"
        rpy="0 0 0"/>
    </xacro:box_inertial>

  </link>

  <joint name="body_joint" type="fixed">
    <parent link="${base_frame}"/>
    <child link="body_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ====================================================
       바퀴 4개
       ==================================================== -->
  <xacro:wheel
    name="wheel_front_left"
    x="${wheel_x}"
    y="${wheel_y}"
    radius="${wheel_radius}"
    width="${wheel_width}"
    mass="${wheel_mass}"/>

  <xacro:wheel
    name="wheel_front_right"
    x="${wheel_x}"
    y="${-wheel_y}"
    radius="${wheel_radius}"
    width="${wheel_width}"
    mass="${wheel_mass}"/>

  <xacro:wheel
    name="wheel_rear_left"
    x="${-wheel_x}"
    y="${wheel_y}"
    radius="${wheel_radius}"
    width="${wheel_width}"
    mass="${wheel_mass}"/>

  <xacro:wheel
    name="wheel_rear_right"
    x="${-wheel_x}"
    y="${-wheel_y}"
    radius="${wheel_radius}"
    width="${wheel_width}"
    mass="${wheel_mass}"/>

  <!-- ====================================================
       LiDAR: laser_link의 원점은 스캔 평면 중심
       ==================================================== -->
  <link name="${laser_frame}">
    <visual>
      <!-- 기존 센서 외함 시각화 오프셋 -->
      <origin
        xyz="0 0 ${-lidar_body_height/2 + 0.011}"
        rpy="0 0 0"/>
      <geometry>
        <cylinder
          radius="${lidar_body_radius}"
          length="${lidar_body_height}"/>
      </geometry>
      <material name="sensor_dark"/>
    </visual>

    <xacro:cylinder_inertial_z
      mass="${lidar_mass}"
      radius="${lidar_body_radius}"
      length="${lidar_body_height}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:cylinder_inertial_z>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="${base_frame}"/>
    <child link="${laser_frame}"/>
    <origin
      xyz="${lidar_x} ${lidar_y} ${lidar_z - base_z}"
      rpy="0 0 0"/>
  </joint>

  <!-- ====================================================
       IMU
       ==================================================== -->
  <link name="${imu_frame}">
    <visual>
      <geometry>
        <box size="0.02 0.02 0.005"/>
      </geometry>
      <material name="sensor_dark"/>
    </visual>

    <xacro:box_inertial
      mass="0.01"
      x="0.02"
      y="0.02"
      z="0.005">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:box_inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="${base_frame}"/>
    <child link="${imu_frame}"/>
    <origin
      xyz="${imu_x} ${imu_y} ${imu_z - base_z}"
      rpy="0 0 0"/>
  </joint>

  <!-- ====================================================
       카메라: 전방 중앙 1대 (위치 TODO 실측, robot_params.xacro)
       2대 구성으로 바꾸면 이 카메라가 '좌측' 카메라가 된다(이름 유지).
       ==================================================== -->
  <link name="${camera_frame}">
    <visual>
      <origin
        xyz="${-camera_board_depth/2} 0 0"
        rpy="0 0 0"/>
      <geometry>
        <box
          size="${camera_board_depth} ${camera_board_width} ${camera_board_height}"/>
      </geometry>
      <material name="sensor_dark"/>
    </visual>

    <xacro:box_inertial
      mass="0.01"
      x="${camera_board_depth}"
      y="${camera_board_width}"
      z="${camera_board_height}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:box_inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="${base_frame}"/>
    <child link="${camera_frame}"/>
    <origin
      xyz="${camera_x} ${camera_y} ${camera_z - base_z}"
      rpy="0 ${camera_pitch} 0"/>
  </joint>

  <!-- 영상 좌표계: x 우측, y 아래쪽, z 전방 -->
  <link name="${camera_optical_frame}"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="${camera_frame}"/>
    <child link="${camera_optical_frame}"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- ====================================================
       (비활성) 2번 카메라 = 2대 구성의 '우측' 카메라
       지금은 생성하지 않는다. 전환할 때 robot_params.xacro 에 camera_2_* 속성
       (위치·높이는 실측값)을 추가한 뒤 아래 예시를 주석 밖으로 옮긴다.
       XML 주석 안에서는 하이픈 두 개를 쓸 수 없으므로 예시는 꺾쇠 대신 [ ] 로 적었다.

       [link name="${camera_2_frame}"]  ... camera_link 와 같은 visual/inertial ... [/link]
       [joint name="camera_2_joint" type="fixed"]
         [parent link="${base_frame}"/] [child link="${camera_2_frame}"/]
         [origin xyz="${camera_2_x} ${camera_2_y} ${camera_2_z - base_z}" rpy="0 ${camera_2_pitch} 0"/]
       [/joint]
       [link name="${camera_2_optical_frame}"/]
       [joint name="camera_2_optical_joint" type="fixed"]
         [parent link="${camera_2_frame}"/] [child link="${camera_2_optical_frame}"/]
         [origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/]
       [/joint]
       ==================================================== -->

  <!-- ====================================================
       시뮬레이션 센서와 구동 플러그인
       ==================================================== -->
  <xacro:if value="$(arg sim)">
    <xacro:include
      filename="$(find robot_description)/urdf/gazebo.xacro"/>
  </xacro:if>

</robot>