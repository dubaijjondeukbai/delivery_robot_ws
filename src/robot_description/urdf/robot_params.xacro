<?xml version="1.0"?>
<!--
  robot_params.xacro

  로봇 모델의 공통 치수와 센서 파라미터.
  단위: m, kg, rad, s.

  이번 변경:
    - Raspberry Pi Camera Module 3 일반형 기준으로 설명/시뮬레이션 화각 정리.
    - 두 번째 카메라의 프레임/토픽 이름만 예약.

  기존 차체 치수, 질량, 장착 위치와 구동 파라미터는 유지한다.
  기존 모델 값이며 최신 CAD/실물과 다시 대조한 실측값은 아니다.
  두 번째 카메라의 장착 위치/방향은 아직 확정하지 않는다.

  *_z는 수평 바닥에 서 있을 때 바닥 기준 높이이다.
  base_link의 높이는 wheel_radius이며, URDF에서 상대 높이로 변환한다.
  여기서 world라는 표현을 쓰더라도 별도의 world TF를 만드는 것은 아니다.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 차체: 기존 모델 치수 유지 -->
  <xacro:property name="chassis_length" value="0.60"/>
  <xacro:property name="chassis_width" value="0.30"/>
  <xacro:property name="chassis_height" value="0.10"/>
  <xacro:property name="chassis_bottom_z" value="0.05"/>

  <!--
    바퀴 4개: 기존 skid-steer 모델 유지.
    wheel_x: 앞/뒤 바퀴 중심 간격의 절반.
    wheel_y: 좌/우 바퀴 중심 간격의 절반.
    chassis_width는 바퀴 등을 포함한 로봇 전체 폭이 아니다.
  -->
  <xacro:property name="wheel_radius" value="0.0857"/>
  <xacro:property name="wheel_width" value="0.052"/>
  <xacro:property name="wheel_x" value="0.200"/>
  <xacro:property name="wheel_y" value="0.275"/>
  <xacro:property name="wheel_mass" value="2.5"/>

  <!--
    기존 시뮬레이션 구동 제한값 유지.
    150 rpm은 검증된 실물 정격값으로 취급하지 않는다.
    아래 계산값은 Nav2 운행 속도나 안전 관리자의 제한값을 대신하지 않는다.
    이 파일을 수정해도 실물 모터 드라이버의 제한값은 변경되지 않는다.
  -->
  <xacro:property name="wheel_max_rpm" value="150.0"/>
  <xacro:property name="max_linear_velocity"
                  value="${wheel_max_rpm / 60.0 * 2.0 * pi * wheel_radius}"/>
  <xacro:property name="max_angular_velocity"
                  value="${2.0 * max_linear_velocity / (2.0 * wheel_y)}"/>
  <xacro:property name="max_linear_acceleration" value="1.0"/>
  <xacro:property name="max_angular_acceleration" value="2.0"/>

  <!-- Gazebo 마찰 계수: 기존 근사값 유지, 실물 시험으로 조정 필요 -->
  <xacro:property name="wheel_mu1" value="1.0"/>
  <xacro:property name="wheel_mu2" value="0.5"/>

  <!-- 적재함: 기존 모델 치수 유지 -->
  <xacro:property name="cargo_length" value="0.502"/>
  <xacro:property name="cargo_width" value="0.570"/>
  <xacro:property name="cargo_height" value="0.380"/>
  <xacro:property name="cargo_x_offset" value="-0.010"/>
  <xacro:property name="cargo_bottom_z" value="0.220"/>

  <!-- 기둥과 상판 -->
  <xacro:property name="pillar_radius" value="0.004"/>
  <xacro:property name="pillar_length" value="0.300"/>
  <xacro:property name="pillar_x" value="0.200"/>
  <xacro:property name="pillar_y" value="0.240"/>
  <xacro:property name="pillar_center_z" value="0.370"/>
  <xacro:property name="top_plate_length" value="0.440"/>
  <xacro:property name="top_plate_width" value="0.520"/>
  <xacro:property name="top_plate_thickness" value="0.003"/>
  <xacro:property name="top_plate_z" value="0.4715"/>

  <!-- 손잡이 아치와 LiDAR 마운트: 기존 근사 형상 유지 -->
  <xacro:property name="arch_bar_length" value="0.060"/>
  <xacro:property name="arch_bar_width" value="0.600"/>
  <xacro:property name="arch_bar_height" value="0.050"/>
  <xacro:property name="arch_bar_z" value="0.625"/>
  <xacro:property name="lidar_mount_radius" value="0.030"/>
  <xacro:property name="lidar_mount_height" value="0.020"/>

  <!--
    질량/관성: 기존 근사값 유지, 실물 계측 필요.
    body_mass는 전체 URDF 질량이 아니다.
    URDF에서는 바퀴와 개별 센서의 질량도 추가된다.
  -->
  <xacro:property name="body_mass" value="25.0"/>
  <xacro:property name="body_com_z" value="0.28"/>
  <xacro:property name="body_inertia_length" value="0.60"/>
  <xacro:property name="body_inertia_width" value="0.57"/>
  <xacro:property name="body_inertia_height" value="0.55"/>

  <!--
    RPLIDAR A2M12.
    lidar_z는 센서 외함 중심이 아니라 스캔 평면의 바닥 기준 높이.
    장착 위치/형상은 기존 모델 값이며 실측 확인이 필요하다.
    아래 샘플 수/주기/범위/노이즈는 Gazebo 센서 설정이다.
    실물 드라이버의 LaserScan 설정을 자동 변경하지 않는다.
  -->
  <xacro:property name="lidar_x" value="0.0"/>
  <xacro:property name="lidar_y" value="0.0"/>
  <xacro:property name="lidar_z" value="0.700"/>
  <xacro:property name="lidar_body_radius" value="0.038"/>
  <xacro:property name="lidar_body_height" value="0.041"/>
  <xacro:property name="lidar_mass" value="0.19"/>
  <xacro:property name="lidar_samples" value="720"/>
  <xacro:property name="lidar_rate_hz" value="10.0"/>
  <xacro:property name="lidar_range_min" value="0.15"/>
  <xacro:property name="lidar_range_max" value="12.0"/>
  <xacro:property name="lidar_noise_std" value="0.01"/>

  <!--
    1번 카메라: Raspberry Pi Camera Module 3 일반형.
    기존 모델의 전방 위치를 임시 유지한다. 최종 2대 배치를 확정한 값은 아니다.
    camera_link: x 전방, y 좌측, z 위쪽.
    camera_optical_frame: x 우측, y 아래쪽, z 전방.
  -->
  <xacro:property name="camera_x" value="0.260"/>
  <xacro:property name="camera_y" value="0.0"/>
  <xacro:property name="camera_z" value="0.450"/>
  <xacro:property name="camera_pitch" value="0.0"/>
  <xacro:property name="camera_board_depth" value="0.0115"/>
  <xacro:property name="camera_board_width" value="0.025"/>
  <xacro:property name="camera_board_height" value="0.024"/>
  <xacro:property name="camera_width" value="640"/>
  <xacro:property name="camera_height" value="480"/>

  <!--
    일반형 공칭 수평 화각 66도를 Gazebo 초기 근사값으로 사용한다.
    실제 640x480 출력은 센서 모드/크롭/초점 등에 따라 달라질 수 있다.
    보정된 실제 출력 화각이 아니며 CameraInfo 내부 파라미터도 아니다.
    실물 보정 후 시뮬레이션 카메라 모델을 별도로 맞춰야 한다.
  -->
  <xacro:property name="camera_hfov" value="${66.0 * pi / 180.0}"/>
  <xacro:property name="camera_rate_hz" value="15.0"/>

  <!-- IMU: 기존 장착 위치와 시뮬레이션 주기 유지 -->
  <xacro:property name="imu_x" value="0.0"/>
  <xacro:property name="imu_y" value="0.0"/>
  <xacro:property name="imu_z" value="0.100"/>
  <xacro:property name="imu_rate_hz" value="100.0"/>

  <!-- 기존 프레임 이름 유지 -->
  <xacro:property name="base_frame" value="base_link"/>
  <xacro:property name="laser_frame" value="laser_link"/>
  <xacro:property name="imu_frame" value="imu_link"/>
  <xacro:property name="camera_frame" value="camera_link"/>
  <xacro:property name="camera_optical_frame" value="camera_optical_frame"/>

  <!-- 기존 토픽 이름 유지 -->
  <xacro:property name="scan_topic" value="/scan"/>
  <xacro:property name="imu_topic" value="/imu/data"/>
  <xacro:property name="image_topic" value="/camera/image_raw"/>
  <xacro:property name="camera_info_topic" value="/camera/camera_info"/>
  <xacro:property name="joint_states_topic" value="/joint_states"/>

  <!--
    두 번째 카메라: vision.yaml과 이름만 맞춰 예약한다.
    이 속성만 추가해도 link/TF/센서/노드가 생성되는 것은 아니다.
    위치/방향을 임의 지정하거나 원점에 TF를 추가하지 않는다.
  -->
  <xacro:property name="camera_2_frame" value="camera_2_link"/>
  <xacro:property name="camera_2_optical_frame" value="camera_2_optical_frame"/>
  <xacro:property name="camera_2_image_topic" value="/camera_2/image_raw"/>
  <xacro:property name="camera_2_info_topic" value="/camera_2/camera_info"/>

  <!-- Gazebo 구동 플러그인의 내부 토픽: 기존 bridge와 호환 유지 -->
  <xacro:property name="gz_cmd_vel_topic" value="/model/delivery_robot/cmd_vel"/>
  <xacro:property name="gz_odom_topic" value="/model/delivery_robot/odometry"/>
  <xacro:property name="gz_odom_cov_topic" value="/model/delivery_robot/odometry_with_covariance"/>
  <xacro:property name="gz_tf_topic" value="/model/delivery_robot/tf"/>

</robot>