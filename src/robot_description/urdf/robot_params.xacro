<?xml version="1.0"?>
<!--
  robot_params.xacro

  로봇 모델의 공통 치수와 센서 파라미터.
  단위: m, kg, rad, s.

  2026-10-27: Fusion 전체 설계(CompleteDesign.zip / Complete+Design.obj, mm, Z-up)에서
  바운딩 박스를 읽어 차체·바퀴·적재함·아치·LiDAR·카메라 치수를 갱신했고,
  같은 날 디테일 모델(DELIVERY ROBOT DETAIL.obj)로 LiDAR x(0.253→0.261)와
  외곽 길이(얼굴 '눈' 부품 끝 ±0.395)를 보정했다. 디테일 모델에는 뚜껑이 열린 상태가 들어 있다:
  뚜껑 2장이 LiDAR 뒤 약 0.05 m 에 세로로 서서(z 0.63~1.14) 후방 약 157° 를 가린다.
    - 메시 축 → ROS 축: 메시 -Y = 전방(x), 메시 +X = 좌측(y), Z = 위.
      (전방 = 아치·LiDAR 가 있는 쪽 끝, 사용자 확인)
    - 바퀴 반지름은 기존값과 같고 축거 0.40 → 0.46, 윤거 0.55 → 0.541.
    - 적재함이 로봇 전체를 덮는 0.781 × 0.642 × 0.500 상자가 되었고, 양 측면에
      디스플레이(400×250, 베젤 포함 두께 ~0.033)가 붙어 전체 폭은 0.708.
    - LiDAR 는 중앙이 아니라 전방 끝의 아치 위(x +0.261)로 옮겨졌다.
    - 전면 카메라는 얼굴의 '눈' 부품(z 0.40)이 아니라 전면 하단 범퍼의 까만 점 자리
      (디테일 모델 Body281/357: x 0.348, y ±0.130, z 0.102). 2026-11-01: 1개(중앙) 기준으로
      두고 front_camera_count 로 2개(눈처럼 양옆) 구성을 전환한다.
  질량·관성·IMU 위치·스캔면 높이(0.78)는 실측이 아니라 추정값이다.

  *_z는 수평 바닥에 서 있을 때 바닥 기준 높이이다.
  base_link의 높이는 wheel_radius이며, URDF에서 상대 높이로 변환한다.
  여기서 world라는 표현을 쓰더라도 별도의 world TF를 만드는 것은 아니다.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 하부 섀시(프레임 + 범퍼): 메시 y ±0.375, x ±0.2155, z 0.05~0.175 -->
  <xacro:property name="chassis_length" value="0.750"/>
  <xacro:property name="chassis_width" value="0.431"/>
  <xacro:property name="chassis_height" value="0.125"/>
  <xacro:property name="chassis_bottom_z" value="0.050"/>

  <!--
    바퀴 4개. 실물은 4륜 독립 구동·독립 조향(4WIS, 2026-10-30 결정)이지만 CAD 메시에는
    조향 액추에이터가 보이지 않고, 현재 Gazebo 모델은 DiffDrive(스키드) 근사다.
    4WIS 시뮬레이션은 별도 작업. 바퀴 위치·반지름은 그대로 쓴다.
    wheel_x: 앞/뒤 바퀴 중심 간격의 절반 (축거 0.460).
    wheel_y: 좌/우 바퀴 중심 간격의 절반 (윤거 0.541).
    chassis_width는 바퀴 등을 포함한 로봇 전체 폭이 아니다.
  -->
  <xacro:property name="wheel_radius" value="0.0857"/>
  <xacro:property name="wheel_width" value="0.0545"/>
  <xacro:property name="wheel_x" value="0.230"/>
  <xacro:property name="wheel_y" value="0.2706"/>
  <xacro:property name="wheel_mass" value="2.5"/>

  <!--
    기존 시뮬레이션 구동 제한값 유지.
    150 rpm은 검증된 실물 정격값으로 취급하지 않는다.
    아래 계산값은 Nav2 운행 속도나 안전 관리자의 제한값을 대신하지 않는다.
    이 파일을 수정해도 실물 모터 드라이버의 제한값은 변경되지 않는다.
  -->
  <xacro:property name="wheel_max_rpm" value="150.0"/>
  <xacro:property name="max_linear_velocity"
                  value="${wheel_max_rpm / 60.0 * 2.0 * pi * wheel_radius}"/>
  <xacro:property name="max_angular_velocity"
                  value="${2.0 * max_linear_velocity / (2.0 * wheel_y)}"/>
  <xacro:property name="max_linear_acceleration" value="1.0"/>
  <xacro:property name="max_angular_acceleration" value="2.0"/>

  <!-- Gazebo 마찰 계수: 기존 근사값 유지, 실물 시험으로 조정 필요 -->
  <xacro:property name="wheel_mu1" value="1.0"/>
  <xacro:property name="wheel_mu2" value="0.5"/>

  <!-- 적재함(외함): 메시 Body1, x ±0.3907, y ±0.321, z 0.150~0.650 -->
  <xacro:property name="cargo_length" value="0.781"/>
  <xacro:property name="cargo_width" value="0.642"/>
  <xacro:property name="cargo_height" value="0.500"/>
  <xacro:property name="cargo_x_offset" value="0.0"/>
  <xacro:property name="cargo_bottom_z" value="0.150"/>

  <!--
    측면 디스플레이 2개(패널 400×250 + 베젤 460×310): 외함 측면 바깥에 붙어
    로봇 전체 폭을 0.708 로 만든다. 충돌 형상은 외함을 이 폭으로 넓힌 상자 하나로 둔다.
    display_x: 전방 기준 중심 위치(메시 y -0.109 → ROS x +0.109).
  -->
  <xacro:property name="display_length" value="0.460"/>
  <xacro:property name="display_height" value="0.310"/>
  <xacro:property name="display_thickness" value="0.033"/>
  <xacro:property name="display_x" value="0.109"/>
  <xacro:property name="display_z" value="0.400"/>
  <xacro:property name="body_envelope_width" value="0.708"/>

  <!-- 리프트 다리 4개(적재함 아래, 바퀴 안쪽): 시각화만. 메시 (±0.139 측면, ±0.230 전후), z 0.04~0.19 -->
  <xacro:property name="lift_leg_length" value="0.160"/>
  <xacro:property name="lift_leg_width" value="0.100"/>
  <xacro:property name="lift_leg_height" value="0.150"/>
  <xacro:property name="lift_leg_x" value="0.230"/>
  <xacro:property name="lift_leg_y" value="0.139"/>
  <xacro:property name="lift_leg_center_z" value="0.115"/>

  <!--
    손잡이 아치(메시 Headset1): 전방 끝, 폭 0.689, 두께 0.114, z 0.525~0.740 의 상자로 근사.
    실제로는 외함 양옆을 지나는 고리 형상이며, 위에 LiDAR 마운트(0.010)가 얹혀 LiDAR
    외함 바닥이 0.750 이 된다.
  -->
  <xacro:property name="arch_x" value="0.233"/>
  <xacro:property name="arch_bar_length" value="0.114"/>
  <xacro:property name="arch_bar_width" value="0.689"/>
  <xacro:property name="arch_bar_height" value="0.215"/>
  <xacro:property name="arch_bar_z" value="0.6325"/>
  <xacro:property name="lidar_mount_radius" value="0.030"/>
  <xacro:property name="lidar_mount_height" value="0.010"/>

  <!--
    질량/관성: 근사값 유지(총 ~35 kg = body 25 + 바퀴 4×2.5), 실물 계측 필요.
    body_mass는 전체 URDF 질량이 아니다.
    URDF에서는 바퀴와 개별 센서의 질량도 추가된다.
  -->
  <xacro:property name="body_mass" value="25.0"/>
  <xacro:property name="body_com_z" value="0.30"/>
  <xacro:property name="body_inertia_length" value="0.781"/>
  <xacro:property name="body_inertia_width" value="0.708"/>
  <xacro:property name="body_inertia_height" value="0.650"/>

  <!--
    RPLIDAR A2M12: 전방 끝 아치 위 (메시 (0, -0.253), 외함 z 0.750~0.791).
    lidar_z는 센서 외함 중심이 아니라 스캔 평면의 바닥 기준 높이이며,
    외함 바닥 + 0.030 으로 추정했다(TODO: 실물에서 스캔면 높이 실측).
    아래 샘플 수/주기/범위/노이즈는 Gazebo 센서 설정이다.
    실물 드라이버의 LaserScan 설정을 자동 변경하지 않는다.
  -->
  <xacro:property name="lidar_x" value="0.261"/>
  <xacro:property name="lidar_y" value="0.0"/>
  <xacro:property name="lidar_z" value="0.783"/>
  <xacro:property name="lidar_body_radius" value="0.038"/>
  <xacro:property name="lidar_body_height" value="0.041"/>
  <xacro:property name="lidar_mass" value="0.19"/>
  <xacro:property name="lidar_samples" value="720"/>
  <xacro:property name="lidar_rate_hz" value="10.0"/>
  <xacro:property name="lidar_range_min" value="0.15"/>
  <xacro:property name="lidar_range_max" value="12.0"/>
  <xacro:property name="lidar_noise_std" value="0.01"/>

  <!--
    전면 카메라: Raspberry Pi Camera Module 3 (Wide).
    위치는 전면 하단 범퍼(z 0.034~0.170)의 까만 점 자리이며, 얼굴의 '눈' 부품(z 0.40)이 아니다.
    디테일 모델 Body281/357: base_link 기준 x 0.348, y ±0.130, z 0.102 (범퍼 전면은 x 0.355).

      front_camera_count = 1 : 범퍼 전면 중앙 (0.350, 0.0, 0.102)      <- 현재 기준
      front_camera_count = 2 : 눈처럼 양옆  (0.348, ±0.130, 0.102)     <- 값만 2 로 바꾸면 전환

    2 로 바꾸면 camera_link 가 좌측(+y)으로 가고 camera_2_link(우측, -y)와 TF 가 생긴다.
    camera_link: x 전방, y 좌측, z 위쪽.
    camera_optical_frame: x 우측, y 아래쪽, z 전방.
    pitch 는 미확인(0). 지면에서 0.10 m 라 전방 바닥이 화면 아래쪽에 넓게 들어온다.
  -->
  <xacro:property name="front_camera_count" value="1"/>

  <!-- 1개 기준(중앙) -->
  <xacro:property name="camera_single_x" value="0.350"/>
  <xacro:property name="camera_single_y" value="0.0"/>

  <!-- 2개 기준(양옆) — front_camera_count = 2 일 때만 사용 -->
  <xacro:property name="camera_pair_x" value="0.348"/>
  <xacro:property name="camera_pair_y" value="0.130"/>

  <xacro:property name="camera_x"
                  value="${camera_single_x if front_camera_count == 1 else camera_pair_x}"/>
  <xacro:property name="camera_y"
                  value="${camera_single_y if front_camera_count == 1 else camera_pair_y}"/>
  <xacro:property name="camera_z" value="0.102"/>
  <xacro:property name="camera_pitch" value="0.0"/>
  <!-- 2번 카메라(우측): front_camera_count = 2 일 때만 link/TF 생성 -->
  <xacro:property name="camera_2_x" value="${camera_pair_x}"/>
  <xacro:property name="camera_2_y" value="${-camera_pair_y}"/>
  <xacro:property name="camera_2_z" value="0.102"/>
  <xacro:property name="camera_2_pitch" value="0.0"/>
  <xacro:property name="camera_board_depth" value="0.0115"/>
  <xacro:property name="camera_board_width" value="0.025"/>
  <xacro:property name="camera_board_height" value="0.024"/>
  <xacro:property name="camera_width" value="640"/>
  <xacro:property name="camera_height" value="480"/>

  <!--
    일반형 공칭 수평 화각 66도를 Gazebo 초기 근사값으로 사용한다.
    실제 640x480 출력은 센서 모드/크롭/초점 등에 따라 달라질 수 있다.
    보정된 실제 출력 화각이 아니며 CameraInfo 내부 파라미터도 아니다.
    실물 보정 후 시뮬레이션 카메라 모델을 별도로 맞춰야 한다.
  -->
  <xacro:property name="camera_hfov" value="${66.0 * pi / 180.0}"/>
  <xacro:property name="camera_rate_hz" value="15.0"/>

  <!-- IMU: 장착 위치 미확인, 기존 값(섀시 중앙, z 0.10) 유지 -->
  <xacro:property name="imu_x" value="0.0"/>
  <xacro:property name="imu_y" value="0.0"/>
  <xacro:property name="imu_z" value="0.100"/>
  <xacro:property name="imu_rate_hz" value="100.0"/>

  <!-- 기존 프레임 이름 유지 -->
  <xacro:property name="base_frame" value="base_link"/>
  <xacro:property name="laser_frame" value="laser_link"/>
  <xacro:property name="imu_frame" value="imu_link"/>
  <xacro:property name="camera_frame" value="camera_link"/>
  <xacro:property name="camera_optical_frame" value="camera_optical_frame"/>

  <!-- 기존 토픽 이름 유지 -->
  <xacro:property name="scan_topic" value="/scan"/>
  <xacro:property name="imu_topic" value="/imu/data"/>
  <xacro:property name="image_topic" value="/camera/image_raw"/>
  <xacro:property name="camera_info_topic" value="/camera/camera_info"/>
  <xacro:property name="joint_states_topic" value="/joint_states"/>

  <!--
    두 번째 카메라: vision.yaml(camera_node_2)과 같은 이름.
    front_camera_count = 2 일 때만 URDF 에 link/TF 를 만든다. Gazebo 센서는 1번 카메라만
    시뮬레이션한다(robot.launch.py 가 sim 에서 enable_camera_2 를 거부함).
  -->
  <xacro:property name="camera_2_frame" value="camera_2_link"/>
  <xacro:property name="camera_2_optical_frame" value="camera_2_optical_frame"/>
  <xacro:property name="camera_2_image_topic" value="/camera_2/image_raw"/>
  <xacro:property name="camera_2_info_topic" value="/camera_2/camera_info"/>

  <!-- Gazebo 구동 플러그인의 내부 토픽: 기존 bridge와 호환 유지 -->
  <xacro:property name="gz_cmd_vel_topic" value="/model/delivery_robot/cmd_vel"/>
  <xacro:property name="gz_odom_topic" value="/model/delivery_robot/odometry"/>
  <xacro:property name="gz_odom_cov_topic" value="/model/delivery_robot/odometry_with_covariance"/>
  <xacro:property name="gz_tf_topic" value="/model/delivery_robot/tf"/>

</robot>
