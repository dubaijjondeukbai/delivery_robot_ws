<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_sim</name>
  <version>0.1.0</version>
  <description>Gazebo (gz-sim) simulation of the delivery robot: exhibition world, robot spawn from robot_description and the ros_gz_bridge that exposes /scan, /imu/data, /camera/*, /wheel/odom and the drive command. Launch + config only; no algorithms.</description>
  <maintainer email="developer@todo.todo">developer</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <!-- Gazebo <-> ROS 2 (rosdep: ros-<distro>-ros-gz-sim / ros-gz-bridge install the matching Gazebo) -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <!-- robot model spawned into the world -->
  <exec_depend>robot_description</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
